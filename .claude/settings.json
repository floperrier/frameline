{
  "extraKnownMarketplaces": {
    "neon": {
      "source": {
        "source": "github",
        "repo": "neondatabase/agent-skills"
      }
    }
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true,
    "neon-postgres@neon": true,
    "mattpocock-skills@mattpocock": false,
    "pstack@pstack-claude": false
  },
  "attribution": { "commit": "", "pr": "", "sessionUrl": false },
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin dev*)",
      "Bash(git push origin main*)",
      "Bash(git push *:dev*)",
      "Bash(git push *:main*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/cloud-setup.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate.sh"
          }
        ]
      }
    ]
  }
}
