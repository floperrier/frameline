# Session cookie sealing secret (any long random string)
NUXT_SESSION_PASSWORD=

# The database `pnpm dev` starts on this machine — see compose.dev.yaml
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:4446/main

# The bucket `pnpm dev` starts beside it, which holds the bytes of every Image
# and every Sound — see compose.dev.yaml. In production these name the R2
# bucket, and are set in Vercel's environment alone.
NUXT_MEDIA_ENDPOINT=http://localhost:4448
NUXT_MEDIA_BUCKET=media
NUXT_MEDIA_ACCESS_KEY_ID=frameline
NUXT_MEDIA_SECRET_ACCESS_KEY=frameline-secret

# The bearer the daily sweep of the bucket is called with (`/api/sweep`). Vercel's
# cron sends it in production, where it is set in Vercel's environment alone.
# Unset, every call to the sweep is refused.
CRON_SECRET=

NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Id of the published Story the landing page links a visitor to read. Unset, no
# such link is shown.
NUXT_PUBLIC_LANDING_STORY=
