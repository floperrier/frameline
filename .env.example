# Session cookie sealing secret (any long random string)
NUXT_SESSION_PASSWORD=

# The database `pnpm dev` starts on this machine — see compose.dev.yaml
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:4446/main

NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Id of the published Story the landing page links a visitor to read. Unset, no
# such link is shown.
NUXT_PUBLIC_LANDING_STORY=
