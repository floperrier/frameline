#!/usr/bin/env bash
# Traces d'outil dans un texte qui finit dans dev : description de PR, message de commit.
#   scripts/trace strip   retire de stdin le pied que le proxy GitHub du cloud ajoute
#   scripts/trace check   échoue, et affiche la ligne en cause, si stdin contient une trace
# Seule définition de ces motifs, pour agent-guard, agent-merge et le hook commit-msg.
# Tout changement passe par scripts/trace.test.sh.
case ${1:-} in
  strip) exec perl -0777 -pe 's{\s*(?:---\s*)?_Generated by \[Claude Code\]\(https://claude\.ai/code(?:/session_\w+)?\)_\s*\z}{}' ;;
  check) ! grep -iE 'Claude-Session|claude\.ai/code/session|Co-Authored-By: Claude|Generated with \[?Claude' >&2 ;;
  *) echo "usage : $0 strip|check" >&2; exit 2 ;;
esac
